# Server Port
PORT=5000

# PostgreSQL Configuration
# If connecting to a PostgreSQL server:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_db
DB_USER=postgres
DB_PASSWORD=postgres

# Or use connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_db

# Mode: 'auto' will try PostgreSQL first, and fallback to PGlite (embedded Postgres) if unreachable
DB_MODE=auto
